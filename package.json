{
  "name": "applibrary",
  "version": "0.1.0",
  "private": true,
  "description": "uesugiyuuto のアプリを紹介するライブラリサイト",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node tools/serve-static.mjs",
    "policy": "node tools/repository-policy.mjs",
    "check:links": "node tools/verify-links.mjs",
    "audit:trace": "node tools/verify-acceptance-trace.mjs",
    "generate": "node tools/generate-agent-wrappers.mjs",
    "check:generated": "node tools/generate-agent-wrappers.mjs --check",
    "lint": "eslint .",
    "typegen": "node tools/generate-next-types.mjs",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:docs": "npm run policy && npm run check:links && npm run audit:trace && npm run check:generated",
    "check:fast": "npm run lint && npm run typecheck && npm run test",
    "check": "npm run check:docs && npm run check:fast && npm run build",
    "verify": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
